# lymow-console environment example. Copy to .env (backend/ cwd) or
# export as environment variables. All variables use the LYMOW_ prefix.

# sim | real  — "real" additionally needs Lymow cloud credentials,
# which are configured through the Settings page (stored server-side),
# NOT in this file.
LYMOW_PROVIDER=sim

# Security: keep 127.0.0.1. Expose to the LAN only via an SSH tunnel or
# an authenticating reverse proxy (see README).
LYMOW_HOST=127.0.0.1
LYMOW_PORT=8384

# SQLite database + generated session key live here (files chmod 0600).
LYMOW_DATA_DIR=~/.local/share/lymow-console

# Lymow cloud region: eu-west-1 | us-east-2 | ap-southeast-2 | ap-east-1
LYMOW_REGION=eu-west-1

# Optional: pin one device thing name instead of auto-discovery.
#LYMOW_DEVICE_THING_NAME=

# Optional: override the generated session-signing secret (a random one
# is created once at <data_dir>/session.key otherwise).
#LYMOW_SESSION_SECRET=

LYMOW_SESSION_MAX_AGE_S=43200
