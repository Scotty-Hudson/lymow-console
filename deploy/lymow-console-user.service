# lymow-console as a *user* service (no sudo). Enable + start (from the
# repo's backend/ dir... or anywhere — %h below is your home):
#   mkdir -p ~/.config/systemd/user
#   cp deploy/lymow-console-user.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now lymow-console
# Start at boot even when logged out:
#   loginctl enable-linger <you>
# Logs: journalctl --user -u lymow-console -f
# Assumes the repo at ~/repos/lymow-console — adjust the two %h lines if not.

[Unit]
Description=lymow-console (Lymow robotic mower web console)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/repos/lymow-console/backend
ExecStart=%h/repos/lymow-console/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8384 --timeout-graceful-shutdown 5
Environment=LYMOW_PROVIDER=real
Environment=LYMOW_DATA_DIR=%h/.local/share/lymow-console
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
