# systemd system unit for lymow-console (installed as root; the app
# process itself runs as an unprivileged User=).
# Install:  sudo cp deploy/lymow-console.service /etc/systemd/system/
#           edit User=/Group= (paths follow that user's home via %h), then
#   sudo systemctl daemon-reload && systemctl enable --now lymow-console
#
# The service binds 127.0.0.1 only; reach it from other machines with
#   ssh -L 8384:127.0.0.1:8384 <this-host>

[Unit]
Description=lymow-console (Lymow robotic mower web console)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# CHANGE ME: the unprivileged user to run as (paths below follow its
# home automatically via the %h specifier — repo lives at ~mower/repos/lymow-console).
User=mower
Group=mower
WorkingDirectory=%h/repos/lymow-console/backend
ExecStart=%h/repos/lymow-console/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8384 --timeout-graceful-shutdown 5
# sim = toy mower, never touches the real one; real = your actual mower.
Environment=LYMOW_PROVIDER=real
Environment=LYMOW_DATA_DIR=%h/.local/share/lymow-console
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/lymow-console
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
